{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:batten:storage:0.1.0",
  "title": "Batten object storage boundary values",
  "description": "CONTRACT-006 owns operation, authority, stream and backend semantics. These definitions do not validate a native UMF envelope.",
  "$defs": {
    "objectRef": {"type":"object","properties":{"resource":{"type":"string","minLength":1},"key":{"type":"string","minLength":1,"description":"Exact UTF-8 relative object key; lexical and backend alias rules are in CONTRACT-006."}},"required":["resource","key"],"additionalProperties":false},
    "requirement": {"type":"object","properties":{"resource":{"type":"string","minLength":1},"interface":{"const":"batten.storage.objects/1"},"operations":{"type":"array","items":{"enum":["read","stat","write","delete","list"]},"minItems":1,"uniqueItems":true},"features":{"type":"array","items":{"enum":["create_only","conditional_replace","conditional_delete","conditional_read","read_range","multipart_upload","resumable_upload","verified_transfer","atomic_publish"]},"uniqueItems":true},"concurrency_domain":{"enum":["native","adapter_managed"]}},"required":["resource","interface","operations","features","concurrency_domain"],"additionalProperties":false},
    "limits": {"type":"object","properties":{"max_object_bytes":{"type":"integer","minimum":1},"max_chunk_bytes":{"type":"integer","minimum":1},"max_page_items":{"type":"integer","minimum":1},"max_scan_entries":{"type":"integer","minimum":1},"max_key_bytes":{"type":"integer","minimum":1},"max_depth":{"type":"integer","minimum":1},"max_cursor_bytes":{"type":"integer","minimum":1},"cursor_ttl_seconds":{"type":"integer","minimum":1},"operation_timeout_ms":{"type":"integer","minimum":1},"max_transfer_buffer_bytes":{"type":"integer","minimum":1},"max_active_transfers":{"type":"integer","minimum":1},"max_parts":{"type":"integer","minimum":1},"max_part_bytes":{"type":"integer","minimum":1},"max_active_uploads":{"type":"integer","minimum":1},"upload_ttl_seconds":{"type":"integer","minimum":1},"max_parallel_parts":{"type":"integer","minimum":1},"max_backend_requests_per_page":{"type":"integer","minimum":1},"max_page_buffer_bytes":{"type":"integer","minimum":1},"max_retry_attempts":{"type":"integer","minimum":1}},"required":["max_object_bytes","max_chunk_bytes","max_page_items","max_scan_entries","max_key_bytes","max_depth","max_cursor_bytes","cursor_ttl_seconds","operation_timeout_ms","max_transfer_buffer_bytes","max_active_transfers","max_parts","max_part_bytes","max_active_uploads","upload_ttl_seconds","max_parallel_parts","max_backend_requests_per_page","max_page_buffer_bytes","max_retry_attempts"],"additionalProperties":false},
    "localBinding": {"type":"object","properties":{"provider":{"const":"batten.storage.local"},"resource":{"type":"string","minLength":1},"root":{"type":"string","minLength":1},"limits":{"$ref":"#/$defs/limits"}},"required":["provider","resource","root","limits"],"additionalProperties":false},
    "volumesBinding": {"type":"object","properties":{"provider":{"const":"batten.databricks.volumes"},"resource":{"type":"string","minLength":1},"workspace_ref":{"type":"string","minLength":1},"volume_root":{"type":"string","minLength":1},"authority_ref":{"type":"string","minLength":1},"limits":{"$ref":"#/$defs/limits"}},"required":["provider","resource","workspace_ref","volume_root","authority_ref","limits"],"additionalProperties":false},
    "objectInfo": {"type":"object","properties":{"key":{"type":"string","minLength":1,"description":"Exact UTF-8 relative object key; lexical and backend alias rules are in CONTRACT-006."},"size_bytes":{"type":"integer","minimum":0},"modified_at":{"anyOf":[{"type":"string","description":"UTC RFC3339 timestamp; null when unavailable."},{"type":"null"}]},"version":{"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},"validator_kind":{"anyOf":[{"enum":["content","revision"]},{"type":"null"}]}},"required":["key","size_bytes","modified_at","version","validator_kind"],"additionalProperties":false},
    "listPage": {"type":"object","properties":{"items":{"type":"array","items":{"oneOf":[{"$ref":"#/$defs/keyEntry"},{"$ref":"#/$defs/summaryEntry"}]}},"next_cursor":{"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},"common_prefixes":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}},"required":["items","next_cursor","common_prefixes"],"additionalProperties":false},
    "writeReceipt": {"type":"object","properties":{"info":{"$ref":"#/$defs/objectInfo"},"outcome":{"const":"complete"},"verification":{"anyOf":[{"$ref":"#/$defs/transferVerification"},{"type":"null"}]}},"required":["info","outcome","verification"],"additionalProperties":false},
    "deleteReceipt": {"type":"object","properties":{"outcome":{"enum":["deleted","absent"]}},"required":["outcome"],"additionalProperties":false},
    "error": {"type":"object","properties":{"code":{"enum":["invalid_key","invalid_request","denied","not_found","path_conflict","unsupported","limit_exceeded","cursor_invalid","cursor_expired","unavailable","timeout","cancelled","io_failure","precondition_failed","range_not_satisfiable","integrity_mismatch","upload_invalid","upload_expired","upload_conflict"]},"effect":{"enum":["none","unknown"]},"incident_id":{"type":"string","minLength":1}},"required":["code","effect","incident_id"],"additionalProperties":false},
    "condition": {"oneOf":[{"type":"object","properties":{"kind":{"const":"any"}},"required":["kind"],"additionalProperties":false},{"type":"object","properties":{"kind":{"const":"absent"}},"required":["kind"],"additionalProperties":false},{"type":"object","properties":{"kind":{"const":"matches"},"version":{"type":"string","minLength":1}},"required":["kind","version"],"additionalProperties":false}]},
    "digest": {"type":"object","properties":{"algorithm":{"const":"sha256"},"hex":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"required":["algorithm","hex"],"additionalProperties":false},
    "keyEntry": {"type":"object","properties":{"key":{"type":"string","minLength":1,"description":"Exact UTF-8 relative object key; lexical and backend alias rules are in CONTRACT-006."}},"required":["key"],"additionalProperties":false},
    "summaryEntry": {"type":"object","properties":{"key":{"type":"string","minLength":1,"description":"Exact UTF-8 relative object key; lexical and backend alias rules are in CONTRACT-006."},"size_bytes":{"anyOf":[{"type":"integer","minimum":0},{"type":"null"}]},"modified_at":{"anyOf":[{"type":"string","description":"UTC RFC3339 timestamp; null when unavailable."},{"type":"null"}]},"version":{"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},"validator_kind":{"anyOf":[{"enum":["content","revision"]},{"type":"null"}]}},"required":["key","size_bytes","modified_at","version","validator_kind"],"additionalProperties":false},
    "transferVerification": {"type":"object","properties":{"digest":{"$ref":"#/$defs/digest"},"scope":{"enum":["source","delivered","stored"]}},"required":["digest","scope"],"additionalProperties":false},
    "readSelection": {"type":"object","properties":{"offset":{"type":"integer","minimum":0},"length":{"type":"integer","minimum":0},"object_size_bytes":{"type":"integer","minimum":0}},"required":["offset","length","object_size_bytes"],"additionalProperties":false},
    "uploadRef": {"type":"object","properties":{"id":{"type":"string","minLength":1}},"required":["id"],"additionalProperties":false},
    "partReceipt": {"type":"object","properties":{"upload":{"$ref":"#/$defs/uploadRef"},"part_number":{"type":"integer","minimum":1},"size_bytes":{"type":"integer","minimum":1},"token":{"type":"string","minLength":1},"digest":{"anyOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]}},"required":["upload","part_number","size_bytes","token","digest"],"additionalProperties":false},
    "partPage": {"type":"object","properties":{"items":{"type":"array","items":{"$ref":"#/$defs/partReceipt"}},"next_cursor":{"anyOf":[{"type":"string","minLength":1},{"type":"null"}]}},"required":["items","next_cursor"],"additionalProperties":false},
    "uploadInfo": {"type":"object","properties":{"upload":{"$ref":"#/$defs/uploadRef"},"state":{"enum":["open","completing","complete","aborting","aborted","expired","unknown"]},"min_part_bytes":{"type":"integer","minimum":1},"max_part_bytes":{"type":"integer","minimum":1},"max_parts":{"type":"integer","minimum":1},"expires_at":{"type":"string","minLength":1},"receipt":{"anyOf":[{"$ref":"#/$defs/writeReceipt"},{"type":"null"}]}},"required":["upload","state","min_part_bytes","max_part_bytes","max_parts","expires_at","receipt"],"additionalProperties":false},
    "abortReceipt": {"type":"object","properties":{"outcome":{"enum":["aborted","already_aborted","already_complete","unknown"]}},"required":["outcome"],"additionalProperties":false},
    "providerProfile": {"type":"object","properties":{"features":{"type":"array","items":{"enum":["create_only","conditional_replace","conditional_delete","conditional_read","read_range","multipart_upload","resumable_upload","verified_transfer","atomic_publish"]},"uniqueItems":true},"concurrency_domain":{"enum":["native","adapter_managed"]},"publication":{"enum":["completion_only","atomic_replace"]},"limits":{"$ref":"#/$defs/limits"}},"required":["features","concurrency_domain","publication","limits"],"additionalProperties":false}
  }
}
