{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:batten:composition-payloads:0.1.0",
  "title": "Batten composition payloads",
  "description": "Proposed extension payloads and immutable metadata projections. Core UMF document validation is upstream-owned. Unknown members are preserved; semantic eligibility is stricter than shape validity.",
  "oneOf": [
    {"$ref": "#/$defs/module"},
    {"$ref": "#/$defs/application"},
    {"$ref": "#/$defs/host"},
    {"$ref": "#/$defs/ui"}
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "pin": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "required": ["id", "version"],
      "additionalProperties": true
    },
    "artifact": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "required": ["id", "sha256"],
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "properties": {
        "artifact": {"$ref": "#/$defs/artifact"},
        "module": {"type": "string", "minLength": 1},
        "element": {"type": "string", "minLength": 1},
        "member": {"type": "string", "minLength": 1}
      },
      "required": ["artifact", "module", "element"],
      "additionalProperties": true
    },
    "requirement": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "interface": {"$ref": "#/$defs/pin"},
        "required": {"type": "boolean"},
        "provider": {"type": "string", "minLength": 1}
      },
      "required": ["id", "interface", "required"],
      "additionalProperties": true
    },
    "setting": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "schema": {"$ref": "#/$defs/target"},
        "secret": {"type": "boolean"}
      },
      "required": ["id", "schema", "secret"],
      "additionalProperties": true
    },
    "module": {
      "type": "object",
      "properties": {
        "kind": {"const": "module"},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sdk": {"type": "string", "minLength": 1},
        "distribution": {"type": "string", "minLength": 1},
        "provides": {
          "type": "array",
          "items": {"$ref": "#/$defs/pin"}
        },
        "requires": {
          "type": "array",
          "items": {"$ref": "#/$defs/requirement"}
        },
        "vocabularies": {
          "type": "array",
          "items": {"$ref": "#/$defs/pin"}
        },
        "settings": {
          "type": "array",
          "items": {"$ref": "#/$defs/setting"}
        },
        "placements": {
          "type": "array",
          "items": {
            "enum": ["in-process", "child-process", "remote-worker"]
          }
        },
        "factory": {"type": "string", "minLength": 1}
      },
      "required": ["kind", "id", "version", "sdk", "distribution", "provides", "requires", "vocabularies", "settings", "placements", "factory"],
      "additionalProperties": true
    },
    "hook": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/$defs/target"},
        "handler": {"$ref": "#/$defs/pin"},
        "requires": {
          "type": "array",
          "items": {"$ref": "#/$defs/requirement"}
        }
      },
      "required": ["id", "target", "handler", "requires"],
      "additionalProperties": true
    },
    "application": {
      "type": "object",
      "properties": {
        "kind": {"const": "application"},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sdk": {"type": "string", "minLength": 1},
        "requires": {
          "type": "array",
          "items": {"$ref": "#/$defs/requirement"}
        },
        "artifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact"}
        },
        "hooks": {
          "type": "array",
          "items": {"$ref": "#/$defs/hook"}
        },
        "ui": {"$ref": "#/$defs/artifact"}
      },
      "required": ["kind", "id", "version", "sdk", "requires", "artifacts", "hooks"],
      "additionalProperties": true
    },
    "binding": {
      "type": "object",
      "properties": {
        "requirement": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "placement": {
          "enum": ["in-process", "child-process", "remote-worker"]
        },
        "ownership": {
          "enum": ["owned", "borrowed"]
        },
        "resource": {"type": "string", "minLength": 1},
        "settings": {"type": "object"},
        "consumer": {"$ref": "#/$defs/artifact"}
      },
      "required": ["requirement", "provider", "placement", "ownership", "resource", "settings", "consumer"],
      "additionalProperties": true
    },
    "host": {
      "type": "object",
      "properties": {
        "kind": {"const": "host"},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "mode": {
          "enum": ["local", "standalone", "embedded"]
        },
        "modules": {
          "type": "array",
          "items": {"$ref": "#/$defs/pin"}
        },
        "bindings": {
          "type": "array",
          "items": {"$ref": "#/$defs/binding"}
        },
        "identity": {"type": "string", "minLength": 1},
        "limits": {"type": "object"},
        "cohort": {"$ref": "#/$defs/artifact"}
      },
      "required": ["kind", "id", "version", "mode", "modules", "bindings", "identity", "limits", "cohort"],
      "additionalProperties": true
    },
    "control": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "operation": {"$ref": "#/$defs/target"},
        "inputs": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/target"}
        }
      },
      "required": ["id", "operation", "inputs"],
      "additionalProperties": true
    },
    "interaction": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "definition": {"$ref": "#/$defs/target"},
        "bindings": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "children": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "required": ["id", "definition", "bindings", "children"],
      "additionalProperties": true
    },
    "localControl": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "artifact": {"$ref": "#/$defs/artifact"},
        "language": {"enum": ["python", "typescript"]},
        "entry": {"type": "string", "minLength": 1},
        "surfaces": {"type": "array", "items": {"enum": ["browser", "terminal"]}},
        "requires": {"type": "array", "items": {"$ref": "#/$defs/requirement"}}
      },
      "required": ["id", "artifact", "language", "entry", "surfaces", "requires"],
      "additionalProperties": true
    },
    "renderer": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "surface": {"enum": ["browser", "terminal"]},
        "assets": {"$ref": "#/$defs/artifact"},
        "client": {"$ref": "#/$defs/pin"},
        "interactions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "localControls": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "required": ["id", "version", "surface", "assets", "client", "interactions", "localControls"],
      "additionalProperties": true
    },
    "ui": {
      "type": "object",
      "properties": {
        "kind": {"const": "ui"},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "application": {"$ref": "#/$defs/pin"},
        "blueprint": {"$ref": "#/$defs/artifact"},
        "assets": {"$ref": "#/$defs/artifact"},
        "client": {"$ref": "#/$defs/pin"},
        "controls": {"type": "array", "items": {"$ref": "#/$defs/control"}},
        "interactions": {"type": "array", "items": {"$ref": "#/$defs/interaction"}},
        "localControls": {"type": "array", "items": {"$ref": "#/$defs/localControl"}},
        "renderers": {"type": "array", "items": {"$ref": "#/$defs/renderer"}}
      },
      "required": ["kind", "id", "version", "application", "controls"],
      "additionalProperties": true,
      "dependentRequired": {"interactions": ["localControls", "renderers"], "localControls": ["interactions", "renderers"], "renderers": ["interactions", "localControls"], "blueprint": ["assets", "client"], "assets": ["blueprint", "client"], "client": ["blueprint", "assets"]},
      "anyOf": [{"required": ["blueprint", "assets", "client"]}, {"required": ["interactions", "localControls", "renderers"]}]
    },
    "limits": {
      "type": "object",
      "properties": {
        "bytes": {"type": "integer", "minimum": 1},
        "items": {"type": "integer", "minimum": 1},
        "depth": {"type": "integer", "minimum": 1}
      },
      "required": ["bytes", "items", "depth"],
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "path": {"type": "string"}
      },
      "required": ["code", "subject", "path"],
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "properties": {
        "artifact": {"$ref": "#/$defs/artifact"},
        "validator": {"$ref": "#/$defs/pin"},
        "vocabularies": {
          "type": "array",
          "items": {"$ref": "#/$defs/pin"}
        },
        "valid": {"type": "boolean"},
        "complete": {"type": "boolean"},
        "findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"}
        }
      },
      "required": ["artifact", "validator", "vocabularies", "valid", "complete", "findings"],
      "additionalProperties": true
    },
    "resolved": {
      "type": "object",
      "properties": {
        "requirement": {"type": "string", "minLength": 1},
        "provider": {"$ref": "#/$defs/pin"},
        "placement": {
          "enum": ["in-process", "child-process", "remote-worker"]
        },
        "consumer": {"$ref": "#/$defs/artifact"}
      },
      "required": ["requirement", "provider", "placement", "consumer"],
      "additionalProperties": true
    },
    "plan": {
      "type": "object",
      "properties": {
        "application": {"$ref": "#/$defs/artifact"},
        "profile": {"$ref": "#/$defs/artifact"},
        "cohort": {"$ref": "#/$defs/artifact"},
        "providers": {
          "type": "array",
          "items": {"$ref": "#/$defs/resolved"}
        },
        "order": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "inactive": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        },
        "limits": {"$ref": "#/$defs/limits"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "required": ["application", "profile", "cohort", "providers", "order", "inactive", "evidence", "limits", "sha256"],
      "additionalProperties": true
    },
    "assessment": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {"const": "eligible"},
            "findings": {
              "type": "array",
              "items": {"$ref": "#/$defs/finding"}
            },
            "plan": {"$ref": "#/$defs/plan"}
          },
          "required": ["state", "findings", "plan"],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "state": {"const": "refused"},
            "findings": {
              "type": "array",
              "items": {"$ref": "#/$defs/finding"}
            },
            "plan": {"type": "null"}
          },
          "required": ["state", "findings", "plan"],
          "additionalProperties": true
        }
      ]
    }
  }
}
