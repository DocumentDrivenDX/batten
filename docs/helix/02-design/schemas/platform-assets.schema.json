{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:batten:platform-assets:0.1.0",
  "title": "Batten platform asset declarations",
  "description": "Companion declaration only. Unknown fields are preserved; relevant unknown semantics refuse admission. Native source bytes and resource semantics remain provider-owned.",
  "type": "object",
  "properties": {
    "kind": {
      "const": "platform-assets"
    },
    "requirement": {
      "type": "string",
      "minLength": 1
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    }
  },
  "required": [
    "kind",
    "requirement",
    "packages",
    "requirements"
  ],
  "additionalProperties": true,
  "$defs": {
    "artifact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "additionalProperties": true
    },
    "pin": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "interface": {
          "$ref": "#/$defs/pin"
        },
        "contract": {
          "$ref": "#/$defs/artifact"
        }
      },
      "required": [
        "id",
        "interface",
        "contract"
      ],
      "additionalProperties": true
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "managed"
            },
            "package": {
              "type": "string",
              "minLength": 1
            },
            "output": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "package",
            "output"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "external"
            },
            "release": {
              "$ref": "#/$defs/artifact"
            },
            "output": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "release",
            "output"
          ],
          "additionalProperties": true
        }
      ]
    },
    "readiness": {
      "type": "object",
      "properties": {
        "profile": {
          "$ref": "#/$defs/pin"
        },
        "predicates": {
          "$ref": "#/$defs/artifact"
        }
      },
      "required": [
        "profile",
        "predicates"
      ],
      "additionalProperties": true
    },
    "requirement": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "interface": {
          "$ref": "#/$defs/pin"
        },
        "contract": {
          "$ref": "#/$defs/artifact"
        },
        "access": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "readiness": {
          "$ref": "#/$defs/readiness"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "required": [
        "id",
        "required",
        "interface",
        "contract",
        "access",
        "readiness",
        "source"
      ],
      "additionalProperties": true
    },
    "package": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "$ref": "#/$defs/pin"
        },
        "entry": {
          "$ref": "#/$defs/artifact"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "minItems": 1
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/output"
          },
          "minItems": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "format",
        "entry",
        "sources",
        "outputs",
        "depends_on"
      ],
      "additionalProperties": true
    },
    "externalRelease": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/output"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "version",
        "owner",
        "outputs"
      ],
      "additionalProperties": true
    }
  }
}
